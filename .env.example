# Password for the /admin panel. Change this to something strong.
ADMIN_PASSWORD=change-this-password

# Random long string used to sign admin login sessions.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# From your Supabase project: Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
# "service_role" key (NOT the "anon" key) — Project Settings -> API -> Project API keys.
# This key has full database access, so it must only ever be used server-side
# (as it is here) and never committed or exposed with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=change-this-to-your-service-role-key

# Same Supabase project's URL + "anon" (public) key. These ARE safe to
# expose to the browser — that's what the anon key is for — and power
# customer login/signup (required before submitting an enquiry).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-this-to-your-anon-key

# Optional but recommended: protects the /api/cron/keep-alive endpoint so
# only Vercel's own cron scheduler can trigger it. Generate with:
# openssl rand -hex 32
# Vercel sets this automatically as a header when it calls scheduled crons
# if you add the same value as an env var named CRON_SECRET.
CRON_SECRET=change-this-to-a-long-random-string

# Your site's real public URL — used for the sitemap and SEO metadata.
# Set this to your Vercel URL, or your custom domain once you have one.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Optional: email alert on every new enquiry/contact message.
# Sign up free at resend.com, then Settings -> API Keys -> create one.
# On the free plan (no domain verified), you can only send TO the email
# address you signed up to Resend with — which is fine here, since alerts
# are meant to go to you anyway. ADMIN_ALERT_EMAIL should be that address.
RESEND_API_KEY=
ADMIN_ALERT_EMAIL=kambojpress@gmail.com
# Leave as-is unless you've verified your own domain in Resend.
RESEND_FROM_EMAIL=Kamboj Press Website <onboarding@resend.dev>

# Optional: free personal WhatsApp alert via CallMeBot (unofficial, meant
# for notifying yourself, not for messaging customers). One-time setup:
# 1. Save +34 644 55 71 43 as a contact on the WhatsApp you want alerts on.
# 2. Message it: "I allow callmebot to send me messages"
# 3. It replies with your API key — put it below along with your number
#    (with country code, no + or spaces, e.g. 917300760078).
WHATSAPP_ALERT_PHONE=
WHATSAPP_ALERT_APIKEY=
